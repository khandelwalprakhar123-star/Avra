# Copy to .env and fill in. Never commit .env.

# ── Twilio (WhatsApp intake + outbound) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── OpenAI (the image model: gpt-image-2) ──────────────────────────────────
OPENAI_API_KEY=
# Override the image model if needed. Defaults to gpt-image-2.
# IMAGE_MODEL=gpt-image-2
# Rendering quality (NOT reasoning/thinking): 'low' | 'medium' | 'high' | 'auto'. Defaults to 'medium'.
# IMAGE_QUALITY=medium
# Output size. Defaults to 1024x1536 (2:3 portrait). e.g. 1024x1024 square, 1536x1024 landscape.
# IMAGE_SIZE=1024x1536

# ── Supabase (image hosting + edit-loop state) ──────────────────────────────
# Use the SERVICE ROLE key. Server-side only; never ship it to a browser.
# Run db/schema.sql ONCE in this project's SQL editor to create the edit-loop tables
# (sent_versions, sessions, closed_cards). Without them the server refuses to boot.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public storage bucket generated images are uploaded to. Auto-created on boot if missing.
SUPABASE_BUCKET=cards

# ── Public URL Twilio signs its webhook against (your ngrok HTTPS URL) ───────
PUBLIC_BASE_URL=
PORT=3000

# Escape hatch for local curl testing. Leave unset (or true) in production.
# VALIDATE_TWILIO_SIGNATURE=false

# ── Spend caps (in-memory; see lib/ratelimit.js) ────────────────────────────
MAX_PER_SENDER_PER_HOUR=50
MAX_GLOBAL_INR_PER_DAY=200
# Each generation is now billed at its REAL token-based cost, computed from gpt-image-2's usage
# (see lib/pricing.js). EST_PER_GEN_INR is only what's reserved against the cap WHILE a generation
# is in flight; it settles to the actual cost right after. ~₹4 fresh, more for edits.
# EST_PER_GEN_INR=4.5

# ── gpt-image-2 token pricing (USD per 1M tokens) + FX, for the real-cost calc ──
# Defaults are OpenAI list price. Override only if the rates change.
# PRICE_TEXT_INPUT_USD_PER_1M=5
# PRICE_IMAGE_INPUT_USD_PER_1M=8
# PRICE_IMAGE_OUTPUT_USD_PER_1M=30
# USD_INR=98

# Max reference images accepted per message (sanity ceiling).
MAX_REFERENCES=6

# How long a bare (non-reply) message still counts as an edit of the open image, in minutes.
# Past this the user has moved on and a bare message starts a fresh image. Replies always work.
# EDIT_WINDOW_MIN=30
