# Copy to .env and fill in. Never commit .env.

# ── Twilio (WhatsApp intake + outbound) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Gemini (the image model — "Nano Banana Lite") ───────────────────────────
GEMINI_API_KEY=
# Override the image model if needed. Defaults to gemini-3.1-flash-lite-image.
# IMAGE_MODEL=gemini-3.1-flash-lite-image

# ── Supabase (image HOSTING only — no database tables in v1.1) ──────────────
# Use the SERVICE ROLE key. Server-side only; never ship it to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public storage bucket generated images are uploaded to. Auto-created on boot if missing.
SUPABASE_BUCKET=cards

# ── Public URL Twilio signs its webhook against (your ngrok HTTPS URL) ───────
PUBLIC_BASE_URL=
PORT=3000

# Escape hatch for local curl testing. Leave unset (or true) in production.
# VALIDATE_TWILIO_SIGNATURE=false

# ── Spend caps (in-memory; see lib/ratelimit.js) ────────────────────────────
MAX_PER_SENDER_PER_HOUR=50
MAX_GLOBAL_INR_PER_DAY=200
COST_PER_GEN_INR=3

# Max reference images accepted per message (sanity ceiling).
MAX_REFERENCES=6
