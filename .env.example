# Copy to .env and fill in the seven required values below. Never commit .env.
#
# Everything under "Optional" already has a working default baked into the code; leave those
# commented out unless you have a reason. The default shown is the real one, taken from the module
# that reads it.

# ══ REQUIRED ═══════════════════════════════════════════════════════════════════
# The server refuses to boot without all seven. It also makes one authenticated call to Twilio at
# startup, so wrong-but-present credentials fail here rather than silently mid-conversation.

# ── Twilio (WhatsApp intake + outbound) ───────────────────────────────────────
# From the Twilio console dashboard. The SID is "AC" followed by 32 hex characters, 34 in total —
# if it has a space in it or is any other length, every media download and every outbound message
# will 401 while the server still appears healthy.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox number below is Twilio's shared public one. Senders must join the sandbox first, and
# it drops them after 72 hours of inactivity.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Supabase (image hosting + edit-loop state) ────────────────────────────────
# Use the SERVICE ROLE key, not the anon/publishable one. Server-side only; never ship it to a
# browser. Run db/schema.sql ONCE in this project's SQL editor to create the edit-loop tables
# (sent_versions, sessions, closed_cards) — without them the server refuses to boot.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── The public URL Twilio signs its webhook against ───────────────────────────
# Twilio computes its signature over the exact URL it called, so this must match byte for byte or
# every webhook is rejected. Behind ngrok, pin the hostname so a reconnect reclaims the same URL:
#
#   ngrok http 3000 --url=https://<your-subdomain>.ngrok-free.dev
#
# Without --url the agent may hand back a different hostname, and Twilio's requests then 404 at
# ngrok's edge. Those are lost silently: Twilio does not retry them and nothing reaches this server.
PUBLIC_BASE_URL=


# ══ OPTIONAL ═══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=3000

# ── Supabase storage (lib/storage.js) ─────────────────────────────────────────
# Public bucket the generated images are uploaded to, auto-created on boot if missing. It must stay
# public: Twilio fetches each image over plain HTTPS with no credentials in order to attach it.
# SUPABASE_BUCKET=cards

# Escape hatch for local curl testing ONLY. Set to false and /whatsapp accepts any POST from
# anyone, which is an unauthenticated image generator spending your OpenAI credits. Never set this
# while PUBLIC_BASE_URL is reachable.
# VALIDATE_TWILIO_SIGNATURE=false

# ── Image generation (lib/generate.js) ────────────────────────────────────────
# IMAGE_MODEL=gpt-image-2
#
# Rendering quality: 'low' | 'medium' | 'high' | 'auto'. This is output polish and detail, NOT a
# reasoning or thinking level — gpt-image-2 has no separate thinking pass.
# IMAGE_QUALITY=medium
#
# Output size. 1024x1536 is 2:3 portrait, both edges divisible by 16. Alternatives: 1024x1024
# square, 1536x1024 landscape.
# IMAGE_SIZE=1024x1536

# ── Reference images (lib/media.js) ───────────────────────────────────────────
# Sanity ceiling on how many attached photos are downloaded per message.
# MAX_REFERENCES=6

# ── The edit loop (lib/session.js) ────────────────────────────────────────────
# How long a bare, non-reply message still counts as an edit of the image currently open. Past this
# the user has moved on and a bare message starts something new. Replying to an image always works,
# regardless of this window.
# EDIT_WINDOW_MIN=30

# ── Spend cap (lib/ratelimit.js) ──────────────────────────────────────────────
# One global ceiling in rupees per day across all senders. There is deliberately no per-sender cap:
# a single sender may spend the whole day's budget.
#
# KNOWN LIMITATION: this ledger is in memory, so it resets to zero on every restart — and
# `npm run dev` is `node --watch`, which restarts on every file save.
# MAX_GLOBAL_INR_PER_DAY=200
#
# Generations are billed at their REAL token-based cost (see below). This value is only what gets
# reserved against the cap WHILE a generation is in flight, so a burst of concurrent requests
# cannot all slip under the ceiling before any has been billed. It settles to the actual cost
# immediately after. Roughly 4 rupees for a fresh generation, more for an edit.
# EST_PER_GEN_INR=4.5

# ── gpt-image-2 token pricing (lib/pricing.js) ────────────────────────────────
# The image API bills three separate meters, in USD per 1M tokens. These are OpenAI list price;
# override only if the rates change. An edit genuinely costs more than a fresh generation because
# the base image is sent back in as input and metered.
#
#   text in    the prompt
#   image in   base + reference images (edits only)
#   image out  the generated image
#
# PRICE_TEXT_INPUT_USD_PER_1M=5
# PRICE_IMAGE_INPUT_USD_PER_1M=8
# PRICE_IMAGE_OUTPUT_USD_PER_1M=30
#
# Fixed USD to INR rate; the bot has no live FX feed. Override when it drifts.
# USD_INR=98
